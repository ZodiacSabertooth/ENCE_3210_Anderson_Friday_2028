module hex_decoder (
    input  wire [2:0] in_code,
    output reg  [7:0] hex
);
    always @(*) begin
        case (in_code)
            3'b000:  hex = 8'b1100_0000; // '0'
            3'b001:  hex = 8'b1111_1001; // '1'
            3'b010:  hex = 8'b1010_0100; // '2'
            3'b011:  hex = 8'b1011_0000; // '3'
            3'b100:  hex = 8'b1001_1001; // '4'
            3'b101:  hex = 8'b1001_0010; // '5'
            3'b110:  hex = 8'b1000_0010; // '6'
            3'b111:  hex = 8'b1111_1000; // '7'
            default: hex = 8'b1111_1111; // Blank
        endcase
    end
endmodule