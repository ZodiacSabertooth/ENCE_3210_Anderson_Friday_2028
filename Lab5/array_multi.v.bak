module array_multi #(
	parameter bit = 4
)(
	input [bit-1:0] a, b,
	output [2*bit-1:0] prod
);

	wire [bit-1:0] s_row [0:bit-1];
	wire [bit-1:0] c_o;
	
	assign s_row[0] = a & {bit{b[0]}};
	assign c_o[0] = 1'b0;
	assign prod[0] = s[0][0];
		
	
	genvar i;
	generate 
		for (i = 1; i < bt; i = i + 1) begin: gen_p
			ripple_adder #(.WIDTH(bit))
			(.A({c_o[i-1], s_row[i-1][bit-1:1]}), .B(a & {bit{b[i]}};), .Sum(s_row[i]), .C_o(c_o[i])
			
			assign prod[i] = s[i][0];
		end
	endgenerate
	
	assign prod[2*bit-1:bit] = {c_o[bit-1], s_row[bit-1][bit-1:1]};
endmodule