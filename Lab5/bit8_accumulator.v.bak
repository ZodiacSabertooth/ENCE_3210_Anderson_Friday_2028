module bit8_accumulator (
	input clk, rst_n, 
	input [7:0] a,
	output reg [7:0] sum,
	output reg c_o, overflow
);

	wire [7:0] next_sum;
	wire next_c_o, next_overflow;
	
	assign {next_c_o, next_sum} = a + sum;
	
	assign next_overflow = (a[7] & sum[7] & ~next_sum[7]) | (~a[7] & ~sum[7] & next_sum[7]);

endmodule
	
	
	